# === Utila auth ===
UTILA_EMAIL=gl-your-service-account@vault-xxxxxxxxxxxx.utilaserviceaccount.io
UTILA_PRIVATE_KEY_PATH=/run/secrets/utila_private.pem

# === Global Ledger ===
GL_API_KEY=YOUR_GL_API_KEY

# === Decisioning ===
RISK_THRESHOLD=60
DEFAULT_DECISION_UNSUPPORTED=APPROVE

# === Server ===
PORT=3000

# === JWT controls ===
JWT_SKEW_SEC=120
JWT_TTL_SEC=3600

# === Retries & scan ===
MAX_TX_ATTEMPTS=12
SCAN_PAGE_SIZE=100

# Optional: restrict startup scan to one vault
# VAULT_ID=12a517c1d56a
